# Product Sentiment Analyzer Environment Variables

# Server Port
PORT=5000

# Database Connection (Default: local SQLite database)
# To use PostgreSQL / Supabase / ElephantSQL:
# DATABASE_URL=postgresql://user:password@host:5432/dbname
# To use SQLite (default zero-config):
DATABASE_URL=sqlite:///sentiment_analyzer.db

# Flask Secret Key
SECRET_KEY=change-this-in-production-sentiment-dashboard

# Selenium Headless Option (true/false)
SELENIUM_HEADLESS=true
